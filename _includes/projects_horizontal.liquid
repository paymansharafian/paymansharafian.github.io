<div class="project-row">
  <div class="project-row-img">
    {% if project.img %}
      <a href="{{ project.url | relative_url }}">
        {% include figure.liquid loading="lazy" path=project.img alt=project.title class="project-thumb" %}
      </a>
    {% else %}
      <a href="{{ project.url | relative_url }}" class="project-thumb-placeholder"></a>
    {% endif %}
  </div>
  <div class="project-row-content">
    <h3 class="project-row-title">
      <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
    </h3>
    <p class="project-row-desc">{{ project.description }}</p>
    {% if project.tech %}
      <div class="project-row-tags">
        {% for tag in project.tech %}
          <span class="project-tag">{{ tag }}</span>
        {% endfor %}
      </div>
    {% endif %}
    <div class="project-row-links">
      {% if project.paper_url %}
        <a href="{{ project.paper_url }}" target="_blank" rel="noopener" class="project-link">[Paper]</a>
      {% endif %}
      {% if project.video_url %}
        <a href="{{ project.video_url }}" target="_blank" rel="noopener" class="project-link">[Video]</a>
      {% endif %}
      {% if project.github_url %}
        <a href="{{ project.github_url }}" target="_blank" rel="noopener" class="project-link">[GitHub]</a>
      {% endif %}
    </div>
  </div>
</div>
